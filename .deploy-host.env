export APP_DIR="$HOME/apps/government-project-agent"
export DATA_DIR="$HOME/data/government-project-agent"

export AGENT_BASE_HOME="$DATA_DIR/runtime"
export AGENT_BASE_CONFIG_PATH="$APP_DIR/config.yaml"
export AGENT_BASE_EXTENSIONS_CONFIG_PATH="$APP_DIR/extensions_config.json"
export AGENT_BASE_REPO_ROOT="$APP_DIR"
export AGENT_BASE_DOCKER_SOCKET="/var/run/docker.sock"

export PORT=2026
export AGENT_BASE_TRUSTED_ORIGINS="http://192.168.2.97:2026,http://127.0.0.1:2026,http://localhost:2026"
